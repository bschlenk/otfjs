{
  "name": "otfjs",
  "version": "1.0.0",
  "author": "Brian Schlenker <bschlenk@umich.edu>",
  "description": "",
  "keywords": [],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./woff2": "./dist/woff2/woff2.js",
    "./tables/cff": "./dist/tables/cff.js",
    "./tables/cmap": "./dist/tables/cmap.js",
    "./tables/colr": "./dist/tables/colr.js",
    "./tables/cpal": "./dist/tables/cpal.js",
    "./tables/cvt": "./dist/tables/cvt.js",
    "./tables/fpgm": "./dist/tables/fpgm.js",
    "./tables/glyf": "./dist/tables/glyf.js",
    "./tables/gpos": "./dist/tables/gpos.js",
    "./tables/head": "./dist/tables/head.js",
    "./tables/hhea": "./dist/tables/hhea.js",
    "./tables/hmtx": "./dist/tables/hmtx.js",
    "./tables/loca": "./dist/tables/loca.js",
    "./tables/math": "./dist/tables/math.js",
    "./tables/maxp": "./dist/tables/maxp.js",
    "./tables/name": "./dist/tables/name.js",
    "./tables/os-2": "./dist/tables/os-2.js",
    "./tables/post": "./dist/tables/post.js",
    "./tables/prep": "./dist/tables/prep.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "tsx ../../packages/otfjs-buffer-gen/src/index.ts 'src/tables/schema/*.ts' src/tables",
    "dev": "tsc --watch --incremental",
    "build": "pnpm generate && tsc",
    "build:gh": "pnpm build",
    "lint": "eslint . --color",
    "lint:fix": "pnpm lint --fix",
    "test": "vitest"
  },
  "dependencies": {
    "@bschlenk/mat": "^0.0.12",
    "@bschlenk/vec": "^0.0.8",
    "@otfjs/buffer": "workspace:*",
    "@otfjs/buffer-types": "workspace:*",
    "brotli": "^1.3.3"
  },
  "devDependencies": {
    "@otfjs/buffer-gen": "workspace:*",
    "@types/brotli": "^1.3.4",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
